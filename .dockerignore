# Keep the build context small and force a clean, in-container build.
node_modules
npm-debug.log*

# Build artifacts
.svelte-kit
build
dist
*.tgz

# Testing / tooling output
coverage
test-results
playwright-report

# Development files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE / VCS / assistant
.vscode
.idea
.git
.gitignore
.claude

# OS
.DS_Store
Thumbs.db

# Documentation not needed to build the site
README.md
CHANGELOG.md
CLAUDE.md

# Local scratch that shouldn't ship in the image
validation_*.md

# Docker / Make config
Dockerfile
.dockerignore
Makefile
.makefile.env
